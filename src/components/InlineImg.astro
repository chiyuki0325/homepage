---
const {
    src,
    alt = "",
} = Astro.props
---

<img src={src} alt={alt} class="inline-img" />

<style lang="scss">
  .inline-img {
    display: inline-block;
    max-width: 100%;
    height: 1.2em;
    width: auto; 
    vertical-align: middle;
    transform: translateY(-0.1em);
  }
</style>