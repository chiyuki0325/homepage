---
import Head from "@components/Head.astro"
import Body from "@components/Body.astro"
import "@styles/fonts.css"
---

<html lang="zh-CN">
  <Head>
    <script
      src="https://ydz-cos.zyglq.cn/blog-static/js/waline.umd.js?v=3"
      id="waline-script"></script>
    <link
      rel="stylesheet"
      href="https://ydz-cos.zyglq.cn/blog-static/css/waline.css"
      id="waline-style"
    />
  </Head>

  <Body activated="/guestbook">
    <p>在茫茫电子之海中的这片孤岛上，相遇即是缘分。</p>
    <p>无论是过客还是常驻的朋友，都欢迎在这里留下你的足迹和心声。</p>
    <script>
      document.addEventListener("astro:page-load", () => {
        Waline.init({
          serverURL: "https://comments-v2.chyk.ink",
          requiredFields: ["nick", "mail"],
          enableQQ: false,
          recordIP: true,
          avatar: "robohash",
          pageSize: 10,
          lang: "zh-cn",
          highlight: true,
          mathJax: false,
          tagMeta: ["博主", "小伙伴", "访客"],
          meta: ["nick", "mail"],
          el: "#waline",
          path: "homepage",
		  locale: {
			placeholder: "📨 写下你的留言 ...",
            nick: "📋️ 昵称",
            mail: "📪 邮箱",
		  }
        })
      })
    </script>

    <div id="waline"></div>
  </Body>

  <style is:global>
    .wl-panel {
      margin: 0.5em 0;
    }

    #waline {
      font-size: 14px;
      --waline-white: #fff;
      --waline-light-grey: #999;
      --waline-dark-grey: #666;
      --waline-theme-color: #0067c0;
      --waline-active-color: #0067c0;
      --waline-color: #444;
      --waline-bgcolor: #fff;
      --waline-bg-color-light: #fff;
      --waline-bg-color-hover: #f0f0f0;
      --waline-border-color: #ddd;
      --waline-disable-bgcolor: #f8f8f8;
      --waline-disable-color: #bbb;
      --waline-code-bgcolor: #282c34;
      --waline-bq-color: #f0f0f0;
      --waline-avatar-size: 3.25rem;
      --waline-m-avatar-size: calc(var(--waline-avatar-size) * 9 / 13);
      --waline-badge-color: #0067c0;
      --waline-badge-font-size: 0.725em;
      --waline-info-bgcolor: #f8f8f8;
      --waline-info-color: #999;
      --waline-info-font-size: 0.725em;
      --waline-border: 1px solid var(--waline-border-color);
      --waline-avatar-radius: 50%;
      --waline-box-shadow: none;
    }
  </style>


</html>
